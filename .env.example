# Copy this file to .env and fill in what you have. Everything is optional.

# Handwriting reading with Gemini (best on messy handwriting). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave blank to use the default model.
GEMINI_MODEL=

# Which reader to use: auto (Gemini if a key is set, otherwise Apple Vision on a Mac), gemini, or apple
MARGIN_READER=auto

MARGIN_PORT=8000
